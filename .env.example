# Reddit access is OPTIONAL. The bot runs on public news feeds without it.
#
# Reddit's Responsible Builder Policy requires approved Data API access:
#   1. Register a dedicated bot account at developers.reddit.com/app-registration
#   2. Request developer access via Reddit's ticket form
# Use a dedicated bot account, not a personal one - mixed-use app accounts
# are prohibited by the policy.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# Only needed to run the CLI standalone. The scheduled path scores sentiment
# inside a Claude session and needs no key.
ANTHROPIC_API_KEY=

FPLBOT_CACHE=~/.cache/fplbot
